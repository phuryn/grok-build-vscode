{
  "name": "grok-vscode-phuryn",
  "displayName": "AFK Pilot: Grok Build, Muse Code, DeepSeek, Claude, Codex & more in one place",
  "description": "One place for Grok Build (Grok 4.7), Muse Code (Muse Wonder) and DeepSeek (V4 Pro), plus Codex (GPT-6 Astra), Claude Code (Opus 5.5) and Google Antigravity (Gemini 4 Argon). Previously Grok Build (Community). Remote Control from your phone, voice control, multiple sessions, images and videos, Mermaid diagrams, and LaTeX. Works with SuperGrok, X Premium+, and xAI API key. Fair Source (FSL-1.1-MIT). Not affiliated with or endorsed by SpaceXAI (formerly xAI), Meta, OpenAI, Anthropic or Google.",
  "version": "4.15.9",
  "publisher": "PawelHuryn",
  "author": {
    "name": "Paweł Huryn",
    "url": "https://www.productcompass.pm"
  },
  "license": "FSL-1.1-MIT",
  "homepage": "https://afkpilot.com",
  "bugs": {
    "url": "https://github.com/phuryn/grok-build-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phuryn/grok-build-vscode"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "grok",
    "grok-build",
    "deepseek",
    "xai",
    "xai-grok",
    "acp",
    "agent-client-protocol",
    "agent",
    "ai",
    "chat",
    "codex",
    "openai-codex",
    "claude",
    "claude-code",
    "muse",
    "muse-code",
    "meta",
    "coding-agent",
    "gui",
    "antigravity",
    "gemini",
    "afk-pilot",
    "remote-control",
    "multi-agent",
    "argon",
    "gemini-4",
    "muse-wonder",
    "gpt",
    "opus",
    "anthropic"
  ],
  "icon": "resources/grok-icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "grokSidebar",
          "title": "%viewsContainers.afkPilot.title%",
          "icon": "resources/grok-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "grokPrimary",
          "title": "%viewsContainers.afkPilot.title%",
          "icon": "resources/grok-icon.svg"
        },
        {
          "id": "grokProjects",
          "title": "%viewsContainers.afkPilot.title%",
          "icon": "resources/grok-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "grokPanel",
          "title": "%viewsContainers.afkPilot.title%",
          "icon": "resources/grok-icon.svg"
        }
      ]
    },
    "views": {
      "grokSidebar": [
        {
          "type": "webview",
          "id": "grok.chat",
          "name": "%views.grok.chat.name%"
        }
      ],
      "grokProjects": [
        {
          "type": "webview",
          "id": "grok.projects",
          "name": "%views.grok.projects.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "grok.continueOnPhone",
        "title": "%commands.grok.continueOnPhone.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.open",
        "title": "%commands.grok.open.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.moveView",
        "title": "%commands.grok.moveView.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.newSession",
        "title": "%commands.grok.newSession.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.newWorktreeSession",
        "title": "%commands.grok.newWorktreeSession.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.applyWorktree",
        "title": "%commands.grok.applyWorktree.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.removeWorktree",
        "title": "%commands.grok.removeWorktree.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.rewind",
        "title": "%commands.grok.rewind.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.compact",
        "title": "%commands.grok.compact.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.pickModel",
        "title": "%commands.grok.pickModel.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.toggleMode",
        "title": "%commands.grok.toggleMode.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.sendSelection",
        "title": "%commands.grok.sendSelection.title%"
      },
      {
        "command": "grok.sendFile",
        "title": "%commands.grok.sendFile.title%"
      },
      {
        "command": "grok.insertAtMention",
        "title": "%commands.grok.insertAtMention.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.rebuildProjects",
        "title": "%commands.grok.rebuildProjects.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.showLogs",
        "title": "%commands.grok.showLogs.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.settings",
        "title": "%commands.grok.settings.title%",
        "category": "%commands.afkPilot.category%",
        "icon": "$(gear)"
      },
      {
        "command": "grok.expandAllToolDetails",
        "title": "%commands.grok.expandAllToolDetails.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.collapseAllToolDetails",
        "title": "%commands.grok.collapseAllToolDetails.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.findInSession",
        "title": "%commands.grok.findInSession.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.logout",
        "title": "%commands.grok.logout.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.linkRemote",
        "title": "%commands.grok.linkRemote.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.unlinkRemote",
        "title": "%commands.grok.unlinkRemote.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok._debugDummyPlan",
        "title": "%commands.grok._debugDummyPlan.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.composerForward",
        "title": "%commands.grok.composerForward.title%",
        "category": "%commands.afkPilot.category%"
      },
      {
        "command": "grok.composerPreviousLine",
        "title": "%commands.grok.composerPreviousLine.title%",
        "category": "%commands.afkPilot.category%"
      }
    ],
    "keybindings": [
      {
        "command": "grok.open",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "grok.insertAtMention",
        "key": "alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "grok.composerForward",
        "key": "ctrl+f",
        "when": "isMac && grok.composerFocus"
      },
      {
        "command": "grok.composerPreviousLine",
        "key": "ctrl+p",
        "when": "isMac && grok.composerFocus"
      },
      {
        "command": "grok.findInSession",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == grok.chat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "grok.settings",
          "when": "view == grok.chat",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "grok._debugDummyPlan",
          "when": "false"
        },
        {
          "command": "grok.composerForward",
          "when": "false"
        },
        {
          "command": "grok.composerPreviousLine",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "grok.sendSelection",
          "when": "editorHasSelection",
          "group": "grok@1"
        }
      ],
      "explorer/context": [
        {
          "command": "grok.sendFile",
          "when": "resourceScheme == file",
          "group": "grok@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "grok.sendFile",
          "when": "resourceScheme == file",
          "group": "grok@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.afkPilot.title%",
      "properties": {
        "grok.homeDirectory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%configuration.grok.homeDirectory.description%"
        },
        "grok.cliPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.cliPath.description%"
        },
        "grok.codexCliPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.codexCliPath.description%"
        },
        "grok.museCliPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.museCliPath.description%"
        },
        "grok.museShellSandbox": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.grok.museShellSandbox.description%"
        },
        "grok.museSandboxNetwork": {
          "type": "string",
          "enum": [
            "proxy-only",
            "restricted",
            "enabled"
          ],
          "default": "proxy-only",
          "description": "%configuration.grok.museSandboxNetwork.description%"
        },
        "grok.museTrustWorkspaces": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.grok.museTrustWorkspaces.description%"
        },
        "grok.claudeCliPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.claudeCliPath.description%"
        },
        "grok.askToAddProjects": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.grok.askToAddProjects.description%"
        },
        "grok.agyServerPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.agyServerPath.description%"
        },
        "grok.defaultModel": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.defaultModel.description%"
        },
        "grok.defaultMode": {
          "type": "string",
          "enum": [
            "",
            "agent",
            "auto",
            "yolo"
          ],
          "enumDescriptions": [
            "%configuration.grok.defaultMode.enumDescriptions.empty%",
            "%configuration.grok.defaultMode.enumDescriptions.agent%",
            "%configuration.grok.defaultMode.enumDescriptions.auto%",
            "%configuration.grok.defaultMode.enumDescriptions.yolo%"
          ],
          "default": "",
          "description": "%configuration.grok.defaultMode.description%"
        },
        "grok.includeActiveFileByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.grok.includeActiveFileByDefault.description%"
        },
        "grok.mentionIndexLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "markdownDescription": "%configuration.grok.mentionIndexLimit.markdownDescription%"
        },
        "grok.acp.promptIdleTimeoutMs": {
          "type": "number",
          "default": 1800000,
          "minimum": 0,
          "markdownDescription": "%configuration.grok.acp.promptIdleTimeoutMs.markdownDescription%"
        },
        "grok.acp.promptAbsoluteTimeoutMs": {
          "type": "number",
          "default": 86400000,
          "minimum": 0,
          "markdownDescription": "%configuration.grok.acp.promptAbsoluteTimeoutMs.markdownDescription%"
        },
        "grok.acp.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "markdownDescription": "%configuration.grok.acp.requestTimeoutMs.markdownDescription%"
        },
        "grok.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "%configuration.grok.defaultEffort.enumDescriptions.empty%",
            "%configuration.grok.defaultEffort.enumDescriptions.none%",
            "%configuration.grok.defaultEffort.enumDescriptions.minimal%",
            "%configuration.grok.defaultEffort.enumDescriptions.low%",
            "%configuration.grok.defaultEffort.enumDescriptions.medium%",
            "%configuration.grok.defaultEffort.enumDescriptions.high%",
            "%configuration.grok.defaultEffort.enumDescriptions.xhigh%"
          ],
          "default": "",
          "description": "%configuration.grok.defaultEffort.description%"
        },
        "grok.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.grok.useCtrlEnterToSend.description%"
        },
        "grok.terminalShell": {
          "type": "string",
          "enum": [
            "auto",
            "cmd"
          ],
          "enumDescriptions": [
            "%configuration.grok.terminalShell.enumDescriptions.auto%",
            "%configuration.grok.terminalShell.enumDescriptions.cmd%"
          ],
          "default": "auto",
          "markdownDescription": "%configuration.grok.terminalShell.markdownDescription%"
        },
        "grok.showThinking": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.showThinking.markdownDescription%"
        },
        "grok.expandCommandOutputs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.expandCommandOutputs.markdownDescription%"
        },
        "grok.expandDiffCard": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.expandDiffCard.markdownDescription%"
        },
        "grok.steerByDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.steerByDefault.markdownDescription%"
        },
        "grok.pinLiveWorkflows": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.grok.pinLiveWorkflows.markdownDescription%"
        },
        "grok.promptNav": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.grok.promptNav.markdownDescription%"
        },
        "grok.soundNotifications": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.soundNotifications.markdownDescription%"
        },
        "grok.processingSound": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.processingSound.markdownDescription%"
        },
        "grok.inputNeededSound": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.inputNeededSound.markdownDescription%"
        },
        "grok.readRepliesAloud": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.grok.readRepliesAloud.description%"
        },
        "grok.summarizeRepliesAloud": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.grok.summarizeRepliesAloud.markdownDescription%"
        },
        "grok.remote.keepAwake": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.grok.remote.keepAwake.markdownDescription%"
        },
        "grok.thumbsFeedback": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.grok.thumbsFeedback.markdownDescription%"
        },
        "grok.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.grok.telemetry.enabled.markdownDescription%"
        },
        "grok.chatFontScale": {
          "type": "number",
          "default": 100,
          "minimum": 60,
          "maximum": 300,
          "markdownDescription": "%configuration.grok.chatFontScale.markdownDescription%"
        },
        "grok.voiceApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.grok.voiceApiKey.markdownDescription%"
        },
        "grok.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.ffmpegPath.description%"
        },
        "grok.voiceInputDevice": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.voiceInputDevice.description%"
        },
        "grok.voiceSendPhrase": {
          "type": "string",
          "default": "grok send",
          "description": "%configuration.grok.voiceSendPhrase.description%"
        },
        "grok.voiceKeyterms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.grok.voiceKeyterms.description%"
        },
        "grok.voiceLanguage": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.voiceLanguage.description%"
        },
        "grok.voiceStreaming": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.grok.voiceStreaming.description%"
        },
        "grok.voiceBackend": {
          "type": "string",
          "enum": [
            "auto",
            "xai",
            "openai"
          ],
          "default": "auto",
          "description": "%configuration.grok.voiceBackend.description%"
        },
        "grok.voiceOpenAiApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.grok.voiceOpenAiApiKey.markdownDescription%"
        },
        "grok.voiceOpenAiModel": {
          "type": "string",
          "enum": [
            "gpt-live-transcribe",
            "gpt-4o-transcribe",
            "gpt-4o-mini-transcribe",
            "whisper-1"
          ],
          "default": "gpt-live-transcribe",
          "description": "%configuration.grok.voiceOpenAiModel.description%"
        },
        "grok.deepseekPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.grok.deepseekPath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p . && npm run compile:muse-adapter",
    "compile:muse-adapter": "tsc -p tsconfig.muse-adapter.json",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "compile:integration": "node -e \"require('fs').rmSync('out-integration',{recursive:true,force:true})\" && tsc -p integration/tsconfig.json",
    "test:integration": "npm run compile && npm run compile:integration && vscode-test",
    "test:live": "tsc -p . && node scripts/live-tests.cjs",
    "desktop": "npm run compile && node scripts/run-desktop.cjs",
    "desktop-dev": "npm run compile && node scripts/run-desktop.cjs --relay-dev --open-devtools --remote-debugging-port=9333",
    "test:desktop": "npm run compile && vitest run --config vitest.desktop.config.ts",
    "e2e:composer": "node scripts/composer-layout-check.mjs",
    "e2e:screens": "npm run compile && node scripts/desk-screens-check.mjs",
    "e2e:open-timing": "npm run compile && node scripts/open-timing-check.mjs",
    "e2e:hc-colour": "node scripts/hc-colour-screens.mjs",
    "e2e:changes": "node scripts/changes-view-screens.mjs",
    "e2e:panel-flow": "node scripts/panel-flow-screens.mjs",
    "e2e:turn-diff": "node scripts/turn-diff-screens.mjs",
    "e2e:welcome-tip": "node scripts/ide-welcome-tip-screens.mjs",
    "e2e:gh-unauth": "npm run compile && node scripts/gh-unauth-check.mjs",
    "marketplace:login": "node scripts/marketplace-session.mjs",
    "marketplace:publish": "node scripts/marketplace-publish.mjs",
    "e2e:lifecycle-host": "npm run compile && node scripts/lifecycle-host.mjs",
    "smoke:live": "npm run compile && node scripts/live-smoke.mjs",
    "smoke:acp": "npm run compile && node scripts/acp-smoke.mjs",
    "smoke:render": "npm run compile && node scripts/smoke-render.mjs",
    "telemetry:probe": "tsc -p . && node scripts/telemetry-probe.cjs",
    "check:relay": "node scripts/check-production-relay.mjs",
    "check:vsix": "npm run compile && node scripts/check-vsix-requires.mjs",
    "prepackage": "node -e \"const fs=require('fs'); for (const f of fs.readdirSync('.')) if (f.endsWith('.vsix')) fs.unlinkSync(f); fs.rmSync('out',{recursive:true,force:true})\" && npm run check:relay && npm run check:vsix",
    "package": "vsce package --readme-path README.marketplace.md",
    "publish": "vsce publish --readme-path README.marketplace.md",
    "publish:ovsx": "node scripts/publish-ovsx.mjs",
    "dist": "npm run compile && electron-builder --publish never",
    "dist:mac": "npm run compile && electron-builder --mac --publish never",
    "dist:win": "npm run compile && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run compile && node scripts/build-linux.cjs",
    "dist:dir": "npm run compile && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "playwright": "^1.49.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.76.0",
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@muse-code/sdk": "1.3.0",
    "electron-updater": "^6.6.4",
    "jpeg-js": "^0.4.4",
    "js-yaml": "4.3.0",
    "qrcode-generator": "2.0.4",
    "ws": "^8.21.0"
  },
  "overrides": {
    "app-builder-lib": {
      "builder-util-runtime": "9.7.0"
    },
    "builder-util": {
      "builder-util-runtime": "9.7.0"
    },
    "dmg-builder": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-builder": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-publish": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-updater": {
      "builder-util-runtime": "9.7.0"
    }
  }
}
